# Pixel 5 / Android 11 is the default high-fidelity test profile because this
# image currently uses an Android 30 (Android 11) x86_64 system image.
#
# Model mapping cross-check:
# - androidtrackers/certified-android-devices: device=redfin,
#   brand=Google, name=Pixel 5, model=Pixel 5.
# - bsthen/device-models: Pixel 5 => brand=Google, name=Pixel 5.
DEVICE_PROFILE_LABEL="Google Pixel 5 / Android 11"
PROFILE_ANDROID_API_LEVEL="30"
PROFILE_ANDROID_RELEASE="11"
PROFILE_DEVICE_NAME="Pixel 5"
PROFILE_MANUFACTURER="Google"
PROFILE_BRAND="google"
PROFILE_MODEL="Pixel 5"
PROFILE_PRODUCT="redfin"
PROFILE_DEVICE="redfin"
PROFILE_REFERENCE_BRAND="Google"
PROFILE_REFERENCE_DEVICE="redfin"
PROFILE_REFERENCE_MODEL="Pixel 5"
PROFILE_REFERENCE_NAME="Pixel 5"
PROFILE_REFERENCE_ANDROIDTRACKERS_URL="https://github.com/androidtrackers/certified-android-devices"
PROFILE_REFERENCE_BSTHEN_URL="https://github.com/bsthen/device-models"
PROFILE_SCREEN_RESOLUTION="1080x2340"
PROFILE_SCREEN_DENSITY="440"
PROFILE_RAM_SIZE="8192"
PROFILE_DNS="one.one.one.one"
PROFILE_LOCALE="en-US"
PROFILE_TIMEZONE="Asia/Shanghai"
PROFILE_AUTO_TIME="0"
PROFILE_AUTO_TIME_ZONE="0"
PROFILE_ACCELEROMETER_ROTATION="0"
PROFILE_LOCATION_MODE="3"
