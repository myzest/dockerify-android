# macOS native emulator runner defaults. Apple Silicon uses arm64-v8a; Intel
# Macs use x86_64. Both keep Android 11/API 30 to match this profile.
PROFILE_MACOS_AVD_NAME="dockerify_pixel_5_android_11"
PROFILE_MACOS_DEVICE_ID="pixel_5"
PROFILE_MACOS_SYSTEM_IMAGE_ARM64="system-images;android-30;google_apis;arm64-v8a"
PROFILE_MACOS_SYSTEM_IMAGE_X86_64="system-images;android-30;google_apis;x86_64"
